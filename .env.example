# Prioridad: variable de entorno > este .env > config.json
# Los ficheros a importar NO tienen ruta por defecto: si no se definen aqui ni en
# config.json, el script los pide por consola. Admiten ~, %VARIABLES% y comillas.

GIT_USER_NAME=
GIT_USER_EMAIL=

GPG_KEY_ID=
GPG_PRIVATE_KEY_SOURCE=
# Opcional: un export de la clave privada ya incluye la parte publica
GPG_PUBLIC_KEY_SOURCE=

SSH_PRIVATE_KEY_SOURCE=
# Opcional: si se omite se busca "<privada>.pub" junto a la privada
SSH_PUBLIC_KEY_SOURCE=
# Opcionales: si se omiten, no se importan
SSH_KNOWN_HOSTS_SOURCE=
SSH_AUTH_KEYS_SOURCE=

# Opcionales: destinos (por defecto %USERPROFILE%\.ssh y el nombre del fichero de origen)
SSH_HOME=
SSH_PRIVATE_KEY_DEST=
SSH_PUBLIC_KEY_DEST=
SSH_KNOWN_HOSTS_DEST=
SSH_AUTH_KEYS_DEST=
KEY_BACKUP_ROOT=

# Opcional: otro config.json distinto del que hay junto a Lib.ps1
CONFIG_FILE=
